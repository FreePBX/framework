{
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "povils/figlet",
				"version": "dev-hotfix",
				"source": {
					"type": "git",
					"url": "https://github.com/FreePBX/figlet.git",
					"reference": "hotfix"
				},
				"require": {
					"php": ">=5.5",
					"symfony/console": "^6.0 || ^7.0 || ^8.0"
				},
				"autoload": {
					"psr-4": {
						"Povils\\Figlet\\": "src/Figlet"
					}
				}
			}
		},
		{
			"type": "package",
			"package": {
				"name": "symfony/lock",
				"version": "8.1.4",
				"dist": {
					"url": "https://github.com/symfony/lock/archive/refs/tags/v8.1.4.zip",
					"type": "zip",
					"reference": "v8.1.4"
				},
				"require": {
					"php": ">=8.4.1",
					"psr/log": "^1|^2|^3"
				},
				"autoload": {
					"psr-4": {
						"Symfony\\Component\\Lock\\": ""
					},
					"exclude-from-classmap": [
						"/Tests/"
					]
				}
			}
		}
	],
	"require": {
		"php": "^8.4",
		"symfony/console": "8.1.4",
		"symfony/contracts": "3.7.2",
		"symfony/security-core": "8.1.2",
		"symfony/security-http": "8.1.1",
		"symfony/security-csrf": "8.1.0",
		"symfony/browser-kit": "8.1.1",
		"symfony/css-selector": "8.1.0",
		"symfony/process": "8.1.0",
		"symfony/filesystem": "8.1.2",
		"symfony/lock": "8.1.4",
		"symfony/finder": "8.1.1",
		"symfony/translation": "8.1.4",
		"php-console/php-console": "~3.1.8",
		"filp/whoops": "^2.18",
		"guzzlehttp/guzzle": "^8.0",
		"mobiledetect/mobiledetectlib": "^4.11",
		"sinergi/browser-detector": "~6.1.4",
		"respect/validation": "^2.5",
		"neitanod/forceutf8": "~v2.0.4",
		"rmccue/requests": "^2.0.19",
		"doctrine/dbal": "^3.10",
		"doctrine/cache": "^1.13",
		"doctrine/orm": "^2.20",
		"fightbulc/moment": "^1.35",
		"swiftmailer/swiftmailer": "~6.3.0",
		"ramsey/uuid": "^4.9",
		"brick/math": ">=0.11 <=0.18",
		"nesbot/carbon": "^3.13",
		"malkusch/lock": "^3.1",
		"tedivm/jshrink": "^1.8",
		"composer/ca-bundle": "^1.5",
		"hhxsv5/php-sse": "~2.0.2",
		"sepia/po-parser": "^6.0",
		"simplepie/simplepie": "^1.9",
		"symfony/var-dumper": "8.1.2",
		"splitbrain/php-archive": "^1.5",
		"slim/slim": "^4.15",
		"symfony/polyfill-php72": "^1.31",
		"symfony/polyfill-php73": "^1.31",
		"symfony/polyfill-php80": "^1.31",
		"symfony/polyfill-php81": "^1.31",
		"symfony/polyfill-php82": "^1.31",
		"symfony/polyfill-php83": "^1.31",
		"symfony/polyfill-php84": "^1.31",
		"giggsey/libphonenumber-for-php": "^9.0",
		"monolog/monolog": "^3.10",
		"dragonmantank/cron-expression": "^3.6",
		"povils/figlet": "dev-hotfix"
	},
	"config": {
		"platform": {
			"php": "8.4.1"
		},
		"autoloader-suffix": "pbxframework",
		"optimize-autoloader": true,
		"allow-plugins": {
			"php-http/discovery": true
		}
	}
}
