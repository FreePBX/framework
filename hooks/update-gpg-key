#!/bin/bash
#
# FreePBX Framework Hook: Update GPG Key
#
# Downloads and installs the FreePBX repository GPG key.
# Used by the System Updates tab when the key is expiring.
#
# Usage: /usr/src/freepbx/framework/hooks/update-gpg-key
#

GPG_URL="http://deb.freepbx.org/gpg/aptly-pubkey.asc"
GPG_PATH="/etc/apt/trusted.gpg.d/freepbx.gpg"
RESULT_FILE="/var/spool/asterisk/tmp/gpg_update_result.json"

# Ensure temp directory exists
mkdir -p /var/spool/asterisk/tmp

if [ ! -d "/etc/apt/trusted.gpg.d" ]; then
	echo '{"success":false,"message":"APT trusted key directory does not exist"}' > "$RESULT_FILE"
	exit 1
fi

# Download and install the key
wget -qO - "$GPG_URL" | gpg --dearmor --yes -o "$GPG_PATH" 2>&1
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ]; then
	echo '{"success":true,"message":"GPG key updated successfully"}' > "$RESULT_FILE"
else
	echo '{"success":false,"message":"Failed to update GPG key. Exit code: '"$EXIT_CODE"'"}' > "$RESULT_FILE"
fi

exit $EXIT_CODE
