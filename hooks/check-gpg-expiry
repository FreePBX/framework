#!/usr/bin/php
<?php
/**
 * FreePBX Framework Hook: Check GPG Key Expiry
 *
 * Checks the FreePBX repository GPG key expiry and writes result to JSON.
 * Can be run standalone or invoked by incron. Output is written to
 * /var/spool/asterisk/tmp/gpg_expiry.json for consumption by the admin UI.
 *
 * Usage: /usr/src/freepbx/framework/hooks/check-gpg-expiry
 */

error_reporting(E_ALL);

$gpgPath = '/etc/apt/trusted.gpg.d/freepbx.gpg';
$outFile = '/var/spool/asterisk/tmp/gpg_expiry.json';
$warningDays = 30;

$result = [
	'applicable' => false,
	'needs_update' => false,
	'expires_in_days' => 0,
	'expiry_date' => '',
	'key_id' => '',
];

if (!file_exists($gpgPath)) {
	file_put_contents($outFile, json_encode($result, JSON_PRETTY_PRINT));
	exit(0);
}

$result['applicable'] = true;
$output = [];
$returnVar = 0;
exec('gpg --show-keys ' . escapeshellarg($gpgPath) . ' 2>/dev/null', $output, $returnVar);

if ($returnVar !== 0 || empty($output)) {
	$result['needs_update'] = true;
	file_put_contents($outFile, json_encode($result, JSON_PRETTY_PRINT));
	exit(0);
}

$expiryDate = null;
foreach ($output as $line) {
	if (preg_match('/\[expires:\s*(\d{4}-\d{2}-\d{2})\]/', $line, $m)) {
		$expiryDate = $m[1];
		break;
	}
	if (preg_match('/^\s+([A-F0-9]{16,40})$/', trim($line), $m)) {
		$result['key_id'] = substr($m[1], -16);
	}
}

if (!$expiryDate) {
	$result['needs_update'] = true;
	file_put_contents($outFile, json_encode($result, JSON_PRETTY_PRINT));
	exit(0);
}

$result['expiry_date'] = $expiryDate;
$expiryTs = strtotime($expiryDate);
$now = time();
$result['expires_in_days'] = (int) floor(($expiryTs - $now) / 86400);

if ($result['expires_in_days'] < $warningDays) {
	$result['needs_update'] = true;
}

$dir = dirname($outFile);
if (!is_dir($dir)) {
	@mkdir($dir, 0755, true);
}
file_put_contents($outFile, json_encode($result, JSON_PRETTY_PRINT));